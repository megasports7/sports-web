# Same Supabase project the mobile app uses (sports-mobile-main/.env's
# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY pair) — one backend,
# reused as-is, per docs/M7_CONTRACT.md. The anon key is public-by-design and
# safe in client JS; NEXT_PUBLIC_ is Next.js's client-exposure prefix,
# equivalent to Expo's EXPO_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
